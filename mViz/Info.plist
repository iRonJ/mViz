<plist version="1.0">
<dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>mViz browses and plays your music library and lets you import unprotected device songs with their star ratings.</string>
	<key>NSWorldSensingUsageDescription</key>
	<string>mViz detects room surfaces so glowing particles can bounce off your walls, floor, and furniture.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>mViz uses the microphone to animate immersive particles to the music around you. Audio is never saved.</string>
